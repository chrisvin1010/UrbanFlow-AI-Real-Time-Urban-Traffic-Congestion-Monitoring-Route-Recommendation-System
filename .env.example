# ==========================================
# UrbanFlow AI - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=super-secret-urbanflow-token-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# Database Configuration (MongoDB)
# If local MongoDB is not running, the server automatically starts an in-memory MongoDB instance for seamless zero-config setup!
MONGODB_URI=mongodb://localhost:27017/urbanflow_db

# Redis Caching
# If Redis is unavailable, the server automatically uses high-performance in-memory cache fallback!
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Traffic Simulation
TRAFFIC_SIMULATION_ENABLED=true
TRAFFIC_SIMULATION_INTERVAL_MS=15000
TRAFFIC_DEFAULT_CITY=San Francisco

# Routing Configuration
# Public OSRM routing endpoint (OpenStreetMap Routing Machine)
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving/
NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org/search
